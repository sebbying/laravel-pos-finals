APP_NAME="Counterpoint POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
DB_CONNECTION=sqlite
# SQLite uses database/database.sqlite. For MySQL see README.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=pos@example.com
MAIL_FROM_NAME="Counterpoint POS"
LOG_CHANNEL=single
LOG_LEVEL=debug
